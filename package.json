{
  "name": "rails",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev -w @rails/server\" \"npm:dev -w @rails/web\"",
    "build": "npm run build -w @rails/web",
    "start": "NODE_ENV=production npm run start -w @rails/server",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0"
  }
}
