{
  "name": "rails",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev -w @rails/server\" \"npm:dev -w @rails/web\"",
    "build": "npm run build -w @rails/web",
    "start": "NODE_ENV=production npm run start -w @rails/server",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts/test-run && tsc -p scripts/coordinator-check",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "test-run": "tsx scripts/test-run/cli.ts",
    "coordinator-check": "tsx scripts/coordinator-check/cli.ts"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
